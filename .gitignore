*.dll
*.exe
.DS_Store
example.tf
terraform.tfplan
terraform.tfstate
bin/
dist/
modules-dev/
/pkg/

# Local provider mirror and CLI config produced by `make mirror`.
.provider-mirror/
.terraformrc.local

# Local test/dev environment variables (dot-sourced, never committed).
.env
.env.*
!.env.example.ps1

# The lock file records checksums for the platform that generated it, and the
# dev provider is installed from a local mirror, so it must not be committed.
.terraform/
.terraform.lock.hcl

website/.vagrant
website/.bundle
website/build
website/node_modules
.vagrant/
*.backup
./*.tfstate
.terraform/
*.log
*.bak
*~
.*.swp
.idea
*.iml
*.test
*.iml

website/vendor

# Test exclusions
!command/test-fixtures/**/*.tfstate
!command/test-fixtures/**/.terraform/

# Keep windows files with windows line endings
*.winfile eol=crlf

# Local reference material — logs, scratch files and exports shared with tooling.
/ref/
